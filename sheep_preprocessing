expand_to_regular_grid <- function(df) {
  full_seq <- tibble(
    collar_time_5min = seq(
      from = min(df$collar_time_5min),
      to   = max(df$collar_time_5min),
      by   = "5 mins"
    )
  )
  full_seq |> left_join(df, by = "collar_time_5min")
} ## this accounts for implicit missingness


