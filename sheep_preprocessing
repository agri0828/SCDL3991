apply_manual_cutoff <- function(df, keep_set, cutoff_type, cutoff_date) {
  out <- df

  if (!is.na(keep_set)) {
    out <- out |> filter(set == keep_set)
  }

  if (!is.na(cutoff_type)) {
    if (cutoff_type == "after") {
      out <- out |> filter(as.Date(collar_time_5min) >= cutoff_date)
    } else if (cutoff_type == "before") {
      out <- out |> filter(as.Date(collar_time_5min) < cutoff_date)
    }
  }

  out
}

