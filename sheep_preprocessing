read_collar_lookup <- function(collar_file, sheet = NULL) {
  args <- list(path = collar_file)
  if (!is.null(sheet)) args$sheet <- sheet
  do.call(read_xlsx, args) |>
    rename_with(~ str_trim(.)) |>
    rename(sd_card   = matches("^SD"),
           animal_id = `Animal ID`) |>
    select(sd_card, animal_id) |>
    mutate(across(everything(), as.character))
}

process_sd_card_gps <- function(sd_folder_path, sd_card_name, animal_id,
                                 farm_key, set_label) {

  csv_files <- list.files(sd_folder_path, pattern = "\\.csv$",
                          full.names = TRUE, recursive = TRUE)
  if (length(csv_files) == 0) {
    warning(glue("No CSVs in: {sd_folder_path}"))
    return(NULL)
  }

  raw <- map_dfr(csv_files, \(f) {
    tryCatch({
      read_csv(f, show_col_types = FALSE, col_types = cols(.default = "c"),
               locale = locale(encoding = "latin1")) |>
        dplyr::select(-matches("^0"))
    }, error = function(e) {
      warning(glue("Skipping corrupt file: {basename(f)} — {e$message}"))
      NULL
    })
  })

  if (nrow(raw) == 0) return(NULL)

  raw <- raw |>
    mutate(
      Lat  = suppressWarnings(as.numeric(Lat)),
      Long = suppressWarnings(as.numeric(Long)),
      HDOP = suppressWarnings(as.numeric(HDOP))
    ) |>
    filter(!is.na(Lat), !is.na(Long), Lat != 0, Long != 0) ## original data contained accelerometer data that was collected more frequently than GPS.

  if (nrow(raw) == 0) {
    warning(glue("{sd_folder_path}: no valid GPS fixes (Lat/Long all NA or 0) — skipping"))
    return(NULL)
  }

  raw |>
    mutate(
      collar_time = as.POSIXct(paste(Date, Time), format = "%d/%m/%y %H:%M:%S")
    ) |>
    filter(!is.na(collar_time)) |>
    arrange(collar_time) |>
    mutate(
      farm      = farm_key,
      animal_id = animal_id,
      sd_card   = sd_card_name,
      set       = set_label
    ) |>
    select(farm, animal_id, sd_card, set, collar_time, Lat, Long, HDOP)
}

process_set_gps <- function(set_folder_path, collar_file_name,
                             farm_key, set_label, sheet = NULL) {

  if (file.exists(collar_file_name)) {
    collar_file <- collar_file_name
  } else {
    collar_file <- file.path(set_folder_path, collar_file_name)
  }

  if (!file.exists(collar_file)) stop(glue("Collar file not found:\n  {collar_file}"))

  collar_lookup <- read_collar_lookup(collar_file, sheet = sheet)

  sd_folders <- list.dirs(set_folder_path, recursive = FALSE, full.names = TRUE)
  sd_folders <- sd_folders[!str_detect(basename(sd_folders), "^[._]")]

  if (length(sd_folders) == 0) {
    warning(glue("No SD card subfolders in: {set_folder_path}"))
    return(NULL)
  }

  map_dfr(sd_folders, \(folder) {
    sd_name <- basename(folder)
    animal  <- collar_lookup |> filter(sd_card == sd_name) |> pull(animal_id)

    if (length(animal) == 0 || is.na(animal[1])) {
      warning(glue("  No Animal ID for SD {sd_name} — skipping"))
      return(NULL)
    }

    message(glue("    Processing SD card {sd_name} (animal {animal[1]})..."))
    process_sd_card_gps(folder, sd_name, animal[1], farm_key, set_label)
  })
}


iwalk(farms, \(farm_info, farm_key) {

  feature_path <- file.path(feature_dir, glue("{farm_key}_gps.parquet"))

  if (file.exists(feature_path)) {
    message(glue("[{farm_key}] Already processed — skipping (delete .parquet to rerun)"))
    return()
  }

  message(glue("[{farm_key}] Processing..."))
  farm_path <- file.path(base_dir, farm_info$folder)

  if (farm_info$type == "im") {

    collar_file <- list.files(farm_path, pattern = "Set 1 and 2 - Collar numbers",
                               full.names = TRUE, ignore.case = TRUE)
    if (length(collar_file) == 0) stop(glue("[IM] No collar xlsx found"))

    set1 <- process_set_gps(file.path(farm_path, "Round 1"),
                             collar_file[1], farm_key, "Set 1", sheet = "Round 1")
    set2 <- process_set_gps(file.path(farm_path, "Round 2"),
                             collar_file[1], farm_key, "Set 2", sheet = "Round 2")

  } else {

    set1_path <- file.path(farm_path, farm_info$set1)
    set2_path <- file.path(farm_path, farm_info$set2)

    set1 <- process_set_gps(set1_path, "Set 1 - collar numbers.xlsx", farm_key, "Set 1")
    set2 <- process_set_gps(set2_path, "Set 2 - collar numbers.xlsx", farm_key, "Set 2")
  }

  combined <- bind_rows(set1, set2) |>
    arrange(farm, animal_id, sd_card, collar_time)

  write_parquet(combined, feature_path)

  message(glue(
    "  [{farm_key}] Done | {nrow(combined)} GPS fixes | ",
    "{n_distinct(combined$animal_id)} animals | ",
    "saved -> {feature_path}\n"
  ))

  rm(set1, set2, combined); gc()
})


